    <string name="clipboard_guard_changed">System clipboard change detected</string>
    <string name="clipboard_guard_cleared">Current item cleanup requested; history not deleted</string>
    <string name="clipboard_guard_failed">Clipboard operation incomplete</string>
    <string name="clipboard_guard_expired">Request expired or clipboard changed. Confirm again.</string>
    <string name="clipboard_guard_automatic_warning">While monitoring is on, cleanup will be attempted for the existing current item and new changes, including when protection resumes, you return to this page, or you make a private copy from the keyboard. Ordinary copy and paste may stop working. System or keyboard history, pinned items and cloud copies are outside this cleanup scope. Earlier reads cannot be recalled; newly copied content may also be cleared. Content is not saved. This cannot be undone.</string>
    <string name="clipboard_guard_enable_automatic">Enable automatic cleanup</string>
    <string name="clipboard_guard_confirmation_warning">Only the current clipboard item will be targeted. History, pinned items and cloud copies kept by the system or other keyboards will not be deleted; manage them in the app that stores them.\n\nThis cannot be undone. New content may arrive between checking and clearing, so newly copied content could also be cleared. Content is not saved, and earlier copies cannot be recalled.</string>
    <string name="clipboard_guard_confirm_action">Clear current item</string>
    <string name="clipboard_guard_authenticate_action">Authenticate and continue</string>
    <string name="clipboard_guard_authentication_title">Verify system clipboard cleanup</string>
    <string name="clipboard_guard_inspect_current">Check and clear current item</string>
    <string name="clipboard_guard_history_limit">ZeroInput cannot delete history, pinned items or cloud copies kept by the system or other keyboards. Use the delete controls in the clipboard list that stores them, and turn off history or sync if needed. Clearing the current item does not empty those lists.</string>
    <string name="clipboard_guard_retry">Reconnect monitoring</string>
    <string name="clipboard_guard_not_default">ZeroInput is not the current keyboard. Background monitoring is unavailable.</string>
    <string name="clipboard_guard_locked">Device locked. Clipboard operations are paused.</string>
    <string name="clipboard_guard_read_denied">System clipboard access denied. Check system privacy permissions, then reconnect monitoring.</string>
    <string name="clipboard_guard_write_denied">System clipboard cleanup denied. Check system privacy permissions and try again.</string>
    <string name="clipboard_guard_empty">No accessible current item: it may be empty or the system may have withheld information. Other apps\' history is outside this scope.</string>
    <string name="clipboard_guard_overlay">Floating reminders over other apps</string>
    <string name="clipboard_guard_overlay_permission_missing">Overlay permission is missing. Floating reminders will not appear.</string>
    <string name="clipboard_guard_overlay_permission">Overlay permission settings</string>
    <string name="clipboard_guard_overlay_permission_title">Why overlay permission is needed</string>
    <string name="clipboard_guard_overlay_permission_reason">To show a more noticeable clipboard reminder while you use other apps, ZeroInput needs permission to display over other apps.\n\nThe window contains only generic status and action buttons. It does not display clipboard text or its source, read page text, obtain arbitrary selected text, prevent other readers, or erase other apps\' history. Cleanup still opens a secure confirmation page.\n\nDisabled by default. You can turn it off or revoke permission anytime. It hides when locked; the system or another app may still block it. Continue opens system settings, where you decide whether to grant permission.</string>
