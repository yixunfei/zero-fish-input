    <string name="ai_page_access_title">Page text references</string>
    <string name="ai_page_access_description">Only tapping Reference page in the AI keyboard reads visible text exposed by the current app for your selection. No automatic collection, editable-field reading or clipboard access. Unchecked text is never sent; Send delivers selected text to your configured AI provider. Some apps expose no text, and ordinary labels may contain sensitive information. Review your selection. System accessibility authorization is also required. Return to the keyboard and tap again; authorization never starts capture.</string>
    <string name="ai_page_enable">Allow explicit page text references</string>
    <string name="ai_page_authorize">Open accessibility authorization</string>
    <string name="ai_page_authorized">Service connected. Return to the keyboard to capture.</string>
    <string name="ai_page_not_authorized">Service disconnected. Authorize it in system settings.</string>
    <string name="ai_device_agent_title">Device agent</string>
    <string name="ai_device_agent_service_description">ZeroInput device agent reads the current app and performs controlled actions only during a task you start.</string>
    <string name="ai_device_agent_settings">Device agent settings</string>
    <string name="ai_device_agent_description">The device agent can observe the current app during a task you start and propose clicks, swipes, text entry, and navigation. Other data domains are off by default and require separate consent; the device-agent switch does not grant notification, file, media, communication, contact, calendar, sensor, or system-settings access. Tasks use step approval by default; you can stop a task or revoke access at any time. The current UI, selected attachments, and observations you explicitly allow may be sent to the configured AI provider.</string>
