    <color name="keyboard_mint_text">#173A34</color>
    <color name="keyboard_mint_modifier">#D5EAE4</color>
    <color name="keyboard_mint_outline">#96B5AC</color>
    <color name="keyboard_rose_primary">#923951</color>
    <color name="keyboard_rose_on_primary">#FFFFFF</color>
    <color name="keyboard_rose_accent">#F2BED0</color>
    <color name="keyboard_rose_secondary">#F4D2DE</color>
    <color name="keyboard_rose_surface">#FFF6F8</color>
